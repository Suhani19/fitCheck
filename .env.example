# ==============================================================================
# FitCheck Backend & Client Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for real-time intelligence, voice, and evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Agora RTC & Cloud Agent Credentials (Required for real-time voice interview room)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# FitCheck Database Configuration
# Default PostgreSQL URL (via Docker Compose or local PostgreSQL service)
# Fallback: sqlite+aiosqlite:///./test.db if PostgreSQL is unavailable
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitcheck

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=fitcheck-by-overfit
FIREBASE_SERVICE_ACCOUNT_PATH=

# Speech-to-Text Provider Override (default: 'gemini')
FITCHECK_SPEECH_PROVIDER=gemini

# Optional: Alternative Speech Providers (Experimental)
SARVAM_API_KEY=
GRADIUM_API_KEY=

# ==============================================================================
# Flutter Client Configuration (Optional Dart Defines)
# ==============================================================================
# Pass to Flutter via: flutter run -d chrome --dart-define=FITCHECK_BACKEND_URL=http://localhost:8000
# FITCHECK_BACKEND_URL=http://localhost:8000
# AGORA_APP_ID=your_agora_app_id_here
